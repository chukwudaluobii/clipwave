# ─────────────────────────────────────────────────────────────
# Clipwave — environment template. Copy to `.env` and fill in.
# Everything works in "stub" mode with no third-party keys set.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://clipwave:clipwave@localhost:5432/clipwave?schema=public

# --- Job queue ---
# inline = run the pipeline inside the web server (NO Redis / worker needed). Default.
# bullmq = durable Redis-backed queue + a separate `npm run worker` process (scales rendering).
QUEUE_DRIVER=inline
# Only used when QUEUE_DRIVER=bullmq:
REDIS_URL=redis://localhost:6379

# Free credits granted to every new user on first sign-in (self-serve onboarding).
SIGNUP_BONUS_CREDITS=60

# --- Auth (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Optional OAuth (leave blank to use email-only dev login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Social account connections (real OAuth) ---
# Set the redirect/callback URI in each provider's console to:
#   <APP_URL>/api/social/callback
# YouTube: reuses GOOGLE_CLIENT_ID/SECRET above, or set dedicated ones here.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok: https://developers.tiktok.com  (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram: Meta app with Instagram Graph API (Instagram Business account)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Provider selection (swap implementations without code changes) ---
# transcription: stub | openai | gemini
TRANSCRIPTION_PROVIDER=stub
# llm: stub | openai | anthropic | gemini | openrouter
LLM_PROVIDER=stub
# storage: local | s3
STORAGE_PROVIDER=local

# --- AI provider keys (only needed when provider != stub) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default Anthropic model id for LLM moment detection / metadata
ANTHROPIC_MODEL=claude-opus-4-8

# Gemini — cheapest option, ONE key powers both transcription AND moment detection.
# Get a key at https://aistudio.google.com/apikey  (has a free tier)
#   LLM_PROVIDER=gemini
#   TRANSCRIPTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — one key, routes to many hosted models (OpenAI-compatible API).
# Only used for LLM_PROVIDER=openrouter (moment detection & post copy); no transcription support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Object storage (only needed when STORAGE_PROVIDER=s3) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=clipwave
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Where local storage writes files (STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=./.data/storage

# --- Stripe (billing). Prices are editable in src/config/pricing.ts ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Filled by `npm run stripe:sync` (maps plans -> Stripe price ids)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_SCALE=

# --- Pipeline limits ---
# Max source duration accepted, in minutes
MAX_SOURCE_MINUTES=180
# ffmpeg binary (leave as "ffmpeg" if on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
